def reverse(n):
    if n == 0:
        print(0)

    reversed_num = 0
    # Keep absolute value to preserve mathematical logic for digits
    temp_n = abs(n)

    while temp_n > 0:
        last_digit = temp_n % 10
        reversed_num = (reversed_num * 10) + last_digit
        temp_n //= 10
    print(reversed_num)


reverse(2000)

